        "base building"
      ],
      "definition": "Help affected people organize and act for themselves.",
      "relatedMatch": [
        "http://id.nlm.nih.gov/mesh/D003256"
      ],
      "skos:note": "Informed by: HFRP CLM: grassroots organizing (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/train-advocates",

      ],
      "skos:note": "Informed by: HFRP CLM: digital and social media (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/public-events",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Public events and rallies",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "rallies",
        "marches",
        "town halls"
      ],
      "definition": "Gather people in public to show support.",
      "skos:note": "Informed by: HFRP CLM: rallies and marches (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/polling-and-opinion",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Polling and public opinion",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "surveys",
        "polls"
      ],
      "definition": "Measure what the public and voters think.",
      "skos:note": "Informed by: HFRP CLM: polling (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/pilots-and-demonstrations",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Pilots and demonstrations",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "demonstration projects",
        "model programs"
      ],
      "definition": "Show the policy working on a small scale first.",
      "skos:note": "Informed by: HFRP CLM: demonstration projects (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/legal-action",

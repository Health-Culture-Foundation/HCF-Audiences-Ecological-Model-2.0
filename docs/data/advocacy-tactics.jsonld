    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/research-and-analysis",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Research and analysis",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "issue analysis",
        "data",
        "reports"
      ],
      "definition": "Gather and analyze evidence to make the case.",
      "skos:note": "Informed by: HFRP CLM tactics; CTB ch. 31 (ideas only)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/draft-the-policy",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Draft the policy",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "model legislation",
        "bill text",
        "policy proposal"
      ],
      "definition": "Write the actual policy, bill, rule or model law.",
      "skos:note": "Informed by: HFRP CLM: policy proposal development (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/build-coalitions",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Build coalitions",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "partnerships",
        "alliances"
      ],
      "definition": "Bring organizations together behind one ask.",
      "skos:note": "Informed by: HFRP CLM; CEI ASF (ideas only)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/organize-communities",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",

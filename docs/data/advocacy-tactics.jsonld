      "related": [
        "https://health-culture.org/vocab/audiences/courts-and-judges"
      ],
      "skos:note": "Informed by: HFRP CLM: litigation (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/monitor-and-enforce",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Monitor and enforce",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "compliance monitoring",
        "report violations",
        "watchdog"
      ],
      "definition": "Check that a policy is followed and report when it isn't.",
      "skos:note": "Informed by: HCF addition; GHAI step 10 and RTSL 'monitor and report violations' (ideas only)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/counter-the-opposition",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Counter the opposition",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "opposition research",
        "rapid response",
        "counter-messaging"
      ],
      "definition": "Anticipate and answer the arguments and tactics of opponents.",
      "skos:note": "Informed by: GHAI step 9 (label); CTB ch. 35 (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/budget-advocacy",

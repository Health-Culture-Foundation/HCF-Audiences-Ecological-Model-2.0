      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "capacity building",
        "advocacy training"
      ],
      "definition": "Teach people and groups how to advocate.",
      "skos:note": "Informed by: HCF addition; GHAI Capacity Strengthening program (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/educate-decision-makers",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Educate decision-makers",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "policymaker education",
        "briefings",
        "site visits"
      ],
      "definition": "Give decision-makers and their staff information, without a specific ask.",
      "skos:note": "Informed by: HFRP CLM: policymaker education (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/ask-decision-makers-directly",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Ask decision-makers directly",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "lobbying",
        "direct asks",
        "meetings"
      ],
      "definition": "Ask a decision-maker to support or oppose a specific policy.",
      "skos:note": "Informed by: HFRP CLM: lobbying (idea)",
      "editorialNote": "Rules on lobbying differ by country and by funder; check before tagging grant-funded work."
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/testify-and-brief",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/tactics/",
      "prefLabel": "Testify and brief",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/tactics/",
      "altLabel": [
        "testimony",
        "hearings",
        "public comment"
      ],
      "definition": "Speak or submit comments in a formal hearing or consultation.",
      "skos:note": "Informed by: HCF addition"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/tactics/earned-media-and-stories",

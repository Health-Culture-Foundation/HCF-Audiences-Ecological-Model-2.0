    {
      "id": "https://health-culture.org/vocab/advocacy/outcomes/know",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/outcomes/",
      "prefLabel": "Know about it",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/outcomes/",
      "notation": "1",
      "altLabel": [
        "awareness"
      ],
      "definition": "The audience learns the problem exists and what could fix it.",
      "skos:note": "Informed by: Informed by CEI ASF (awareness) and HFRP CLM interim outcomes; HCF wording"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/outcomes/care",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/outcomes/",
      "prefLabel": "Care about it",
      "topConceptOf": "https://health-culture.org/vocab/advocacy/outcomes/",
      "notation": "2",
      "altLabel": [
        "will",
        "salience",
        "attitudes"
      ],
      "definition": "The audience sees it as important and wants to act.",
      "skos:note": "Informed by: Informed by CEI ASF (will); HCF wording"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/outcomes/public-will",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/outcomes/",
      "prefLabel": "Public will",
      "broader": "https://health-culture.org/vocab/advocacy/outcomes/care",
      "notation": "2.1",
      "definition": "More of the public wants the change.",
      "skos:note": "Informed by: HFRP CLM (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/outcomes/political-will",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/outcomes/",
      "prefLabel": "Political will",
      "broader": "https://health-culture.org/vocab/advocacy/outcomes/care",
      "notation": "2.2",
      "definition": "More decision-makers are willing to act.",
      "skos:note": "Informed by: HFRP CLM (idea)"
    },
    {
      "id": "https://health-culture.org/vocab/advocacy/outcomes/reframing",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/advocacy/outcomes/",

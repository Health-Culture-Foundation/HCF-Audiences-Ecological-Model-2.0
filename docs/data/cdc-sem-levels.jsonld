  "@graph": [
    {
      "id": "https://health-culture.org/vocab/cdc-sem-levels/",
      "type": "skos:ConceptScheme",
      "title": "CDC social-ecological model (four levels)",
      "license": "https://creativecommons.org/licenses/by/4.0/",
      "source": [
        "https://www.cdc.gov/violence-prevention/about/index.html"
      ]
    },
    {
      "id": "https://health-culture.org/vocab/cdc-sem-levels/individual",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/cdc-sem-levels/",
      "topConceptOf": "https://health-culture.org/vocab/cdc-sem-levels/",
      "notation": "1",
      "prefLabel": "Individual",
      "definition": "Biological and personal history factors such as age, education, income, substance use and history of abuse; prevention at this level works on attitudes, beliefs and behaviors.",
      "source": [
        "https://www.cdc.gov/violence-prevention/about/index.html"
      ]
    },
    {
      "id": "https://health-culture.org/vocab/cdc-sem-levels/relationship",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/cdc-sem-levels/",
      "topConceptOf": "https://health-culture.org/vocab/cdc-sem-levels/",
      "notation": "2",
      "prefLabel": "Relationship",
      "definition": "A person's closest social circle (peers, partners and family members) and how it shapes their behavior and experience.",
      "source": [
        "https://www.cdc.gov/violence-prevention/about/index.html"
      ]
    },
    {
      "id": "https://health-culture.org/vocab/cdc-sem-levels/community",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/cdc-sem-levels/",
      "topConceptOf": "https://health-culture.org/vocab/cdc-sem-levels/",
      "notation": "3",
      "prefLabel": "Community",
      "definition": "The settings where social relationships happen, such as schools, workplaces and neighborhoods, and the features of those settings.",
      "source": [
        "https://www.cdc.gov/violence-prevention/about/index.html"
      ]
    },
    {
      "id": "https://health-culture.org/vocab/cdc-sem-levels/societal",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/cdc-sem-levels/",
      "topConceptOf": "https://health-culture.org/vocab/cdc-sem-levels/",
      "notation": "4",
      "prefLabel": "Societal",
      "definition": "Broad societal factors: social and cultural norms, and the health, economic, educational and social policies that maintain or reduce inequalities between groups.",
      "source": [
        "https://www.cdc.gov/violence-prevention/about/index.html"
      ]
    }
  ]
}

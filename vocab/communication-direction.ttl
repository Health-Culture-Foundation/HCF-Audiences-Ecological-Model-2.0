<https://health-culture.org/vocab/communication-direction/> a skos:ConceptScheme ;
  dct:title "Communication direction"@en ;
  dct:description "Who is talking to whom: professional to public, professional to professional (with what the professional does with it), professional to decision-maker, peer to peer, public to professional. Not a level of influence: pair it with audience roles. Draft 0.1."@en ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  skos:hasTopConcept <https://health-culture.org/vocab/communication-direction/pro-to-public>, <https://health-culture.org/vocab/communication-direction/pro-to-pro>, <https://health-culture.org/vocab/communication-direction/pro-to-policy>, <https://health-culture.org/vocab/communication-direction/peer-to-peer>, <https://health-culture.org/vocab/communication-direction/public-to-pro> .

<https://health-culture.org/vocab/communication-direction/pro-to-public> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/communication-direction/> ;
  skos:topConceptOf <https://health-culture.org/vocab/communication-direction/> ;
  skos:notation "1" ;
  skos:prefLabel "Professional to public"@en ;
  skos:altLabel "public-facing"@en ;
  skos:altLabel "for the public"@en ;
  skos:altLabel "for patients"@en ;
  skos:definition "Made by professionals or organizations for people to use about their own or their family's health."@en ;
  skos:example "A CDC page on how much sleep teens need."@en ;
  skos:relatedMatch <http://id.nlm.nih.gov/mesh/D058015> ;
  skos:editorialNote "Most health content. Pair with level-1 and level-2 audiences."@en .
<https://health-culture.org/vocab/communication-direction/pro-to-pro> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/communication-direction/> ;
  skos:topConceptOf <https://health-culture.org/vocab/communication-direction/> ;
  skos:notation "2" ;
  skos:prefLabel "Professional to professional"@en ;
  skos:altLabel "pro2pro"@en ;
  skos:altLabel "for professionals"@en ;
  skos:altLabel "for my work"@en ;
  skos:altLabel "B2B"@en ;
  skos:definition "Made for people to use in their work: to practise, teach, run a program or pass information on. A very large category; the narrower concepts say what the professional does with it."@en ;
  skos:relatedMatch <http://id.nlm.nih.gov/mesh/D007400> ;
  skos:editorialNote "The audience roles (clinicians, health communicators, school and campus leaders...) say which professional and therefore which level. Kalman, 22 Oct: a lot of communications fall into this category."@en .
<https://health-culture.org/vocab/communication-direction/practice-guidance> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/communication-direction/> ;
  skos:broader <https://health-culture.org/vocab/communication-direction/pro-to-pro> ;
  skos:notation "2.1" ;
  skos:prefLabel "Guidance for practice"@en ;
  skos:altLabel "guidelines"@en ;
  skos:altLabel "clinical recommendations"@en ;
  skos:altLabel "standards"@en ;
  skos:altLabel "position statements"@en ;
  skos:definition "Tells professionals what to do in their own practice."@en ;
  skos:example "ACSM guidelines for prescribing exercise; AASM sleep duration recommendations."@en ;
  skos:relatedMatch <http://id.nlm.nih.gov/mesh/D017410> ;
  skos:editorialNote "SleepLiteracy example: ACSM 'Guidelines for prescribing exercise in medicine'."@en .
<https://health-culture.org/vocab/communication-direction/materials-to-pass-on> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/communication-direction/> ;
  skos:broader <https://health-culture.org/vocab/communication-direction/pro-to-pro> ;
  skos:notation "2.2" ;
  skos:prefLabel "Materials to pass on"@en ;
  skos:altLabel "handouts"@en ;
  skos:altLabel "toolkits"@en ;
  skos:altLabel "editable slides"@en ;
  skos:altLabel "campaign kits"@en ;
  skos:altLabel "patient fact sheets"@en ;
  skos:altLabel "pro-to-pro-to-public"@en ;
  skos:definition "Made for professionals to hand on, present or adapt for the people they serve. Two audiences: the professional who uses it and the public who ends up reading it."@en ;
  skos:example "World Sleep Day toolkit with editable slides; patient fact sheets for clinicians to give out."@en ;
  skos:relatedMatch <http://id.nlm.nih.gov/mesh/D029282> ;
  skos:relatedMatch <http://id.nlm.nih.gov/mesh/D033181> ;
  skos:editorialNote "Tag both directions' audiences, e.g. clinicians + the person themselves. MeSH Patient Education Handout is a publication type. SleepLiteracy examples: World Sleep Day resources; Sleep Health Foundation fact sheets."@en .

<https://health-culture.org/vocab/advocacy/phases/win-the-decision> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/advocacy/phases/> ;
  skos:topConceptOf <https://health-culture.org/vocab/advocacy/phases/> ;
  skos:notation "5" ;
  skos:prefLabel "Win the decision"@en ;
  skos:altLabel "policy enactment"@en ;
  skos:altLabel "adoption"@en ;
  skos:altLabel "passage"@en ;
  skos:altLabel "block a harmful policy"@en ;
  skos:definition "Get the bill, rule, budget line or order passed or signed, or stop a harmful one."@en ;
  skos:example "Testifying at the hearing for a school start-time bill."@en ;
  skos:relatedMatch <http://id.nlm.nih.gov/mesh/D007878> ;
  skos:related <https://health-culture.org/vocab/audiences/policymakers> ;

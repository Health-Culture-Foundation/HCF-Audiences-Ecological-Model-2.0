<https://health-culture.org/vocab/advocacy/phases/size-up-the-problem> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/advocacy/phases/> ;
  skos:topConceptOf <https://health-culture.org/vocab/advocacy/phases/> ;
  skos:notation "1" ;
  skos:prefLabel "Size up the problem"@en ;
  skos:altLabel "problem identification"@en ;
  skos:altLabel "landscape analysis"@en ;
  skos:altLabel "needs assessment"@en ;
  skos:definition "Find out who is harmed, how badly, why, and which laws and policies exist now."@en ;

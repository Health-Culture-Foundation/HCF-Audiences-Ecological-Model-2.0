  skos:editorialNote "Use goal type 'Block a harmful policy' for defensive campaigns."@en .
<https://health-culture.org/vocab/advocacy/phases/put-it-into-practice> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/advocacy/phases/> ;
  skos:topConceptOf <https://health-culture.org/vocab/advocacy/phases/> ;
  skos:notation "6" ;
  skos:prefLabel "Put it into practice"@en ;
  skos:altLabel "policy implementation"@en ;
  skos:altLabel "enforcement"@en ;
  skos:altLabel "rollout"@en ;
  skos:definition "Make sure agencies fund, staff, enforce and explain the policy, and that it reaches the people it was meant for."@en ;
  skos:example "Checking that districts actually changed bell times after the law took effect."@en ;
  skos:related <https://health-culture.org/vocab/audiences/regulators-and-agency-staff> ;
  skos:related <https://health-culture.org/vocab/audiences/school-and-campus-leaders> ;
  skos:related <https://health-culture.org/vocab/audiences/employers-and-workplaces> ;
  skos:note "Informed by: CDC Policy Process: implementation; policy cycle: implementation; HFRP: implementation; GHAI step 10 (label)"@en .

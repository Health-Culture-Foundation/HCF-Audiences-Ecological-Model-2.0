<https://health-culture.org/vocab/cdc-sem-levels/> a skos:ConceptScheme ;
  dct:title "CDC social-ecological model (four levels)"@en ;
  dct:description "The four-level social-ecological model used by CDC violence prevention (after Dahlberg and Krug 2002), paraphrased. CDC publishes no URIs for these levels; HCF mints them here so crosswalks have something to point at."@en ;
  dct:source <https://www.cdc.gov/violence-prevention/about/index.html> ;
  dct:license <https://creativecommons.org/licenses/by/4.0/> ;
  skos:hasTopConcept <https://health-culture.org/vocab/cdc-sem-levels/individual>, <https://health-culture.org/vocab/cdc-sem-levels/relationship>, <https://health-culture.org/vocab/cdc-sem-levels/community>, <https://health-culture.org/vocab/cdc-sem-levels/societal> .

<https://health-culture.org/vocab/cdc-sem-levels/individual> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:topConceptOf <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:notation "1" ;
  skos:prefLabel "Individual"@en ;
  skos:definition "Biological and personal history factors such as age, education, income, substance use and history of abuse; prevention at this level works on attitudes, beliefs and behaviors."@en ;
  dct:source <https://www.cdc.gov/violence-prevention/about/index.html> .
<https://health-culture.org/vocab/cdc-sem-levels/relationship> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:topConceptOf <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:notation "2" ;
  skos:prefLabel "Relationship"@en ;
  skos:definition "A person's closest social circle (peers, partners and family members) and how it shapes their behavior and experience."@en ;
  dct:source <https://www.cdc.gov/violence-prevention/about/index.html> .
<https://health-culture.org/vocab/cdc-sem-levels/community> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:topConceptOf <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:notation "3" ;
  skos:prefLabel "Community"@en ;
  skos:definition "The settings where social relationships happen, such as schools, workplaces and neighborhoods, and the features of those settings."@en ;
  dct:source <https://www.cdc.gov/violence-prevention/about/index.html> .
<https://health-culture.org/vocab/cdc-sem-levels/societal> a skos:Concept ;
  skos:inScheme <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:topConceptOf <https://health-culture.org/vocab/cdc-sem-levels/> ;
  skos:notation "4" ;
  skos:prefLabel "Societal"@en ;
  skos:definition "Broad societal factors: social and cultural norms, and the health, economic, educational and social policies that maintain or reduce inequalities between groups."@en ;
  dct:source <https://www.cdc.gov/violence-prevention/about/index.html> .

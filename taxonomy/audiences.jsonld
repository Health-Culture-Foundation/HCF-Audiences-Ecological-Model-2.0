    {
      "id": "https://health-culture.org/vocab/audiences/the-person",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/audiences/",
      "prefLabel": "The person themselves",
      "definition": "Someone reading or using a resource for their own health.",
      "related": [
        "https://health-culture.org/vocab/ecological-levels/intrapersonal"
      ],
      "hcf:facet": "role",
      "topConceptOf": "https://health-culture.org/vocab/audiences/",
      "altLabel": [
        "for me",
        "help yourself",
        "general reader",
        "general public"
      ],
      "example": "A college student looks up how much sleep they need.",
      "closeMatch": [
        "http://id.nlm.nih.gov/mesh/D009272",
        "https://schema.org/PeopleAudience",
        "http://purl.org/dcx/lrmi-vocabs/educationalAudienceRole/generalPublic"
      ],
      "editorialNote": "SleepLiteracy's Help Yourself is used as 'general reader': 19 of 27 Parents resources are also tagged Help Yourself. See open questions."
    },
    {
      "id": "https://health-culture.org/vocab/audiences/patients",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/audiences/",
      "prefLabel": "Patients",
      "definition": "A person getting care for a health condition, using a resource about their own care.",
      "related": [
        "https://health-culture.org/vocab/ecological-levels/intrapersonal"
      ],
      "hcf:facet": "role",
      "broader": "https://health-culture.org/vocab/audiences/the-person",
      "altLabel": [
        "people receiving care",
        "people living with a condition"
      ],
      "example": "Someone newly prescribed CPAP reads how to get used to the mask.",
      "closeMatch": [
        "http://id.nlm.nih.gov/mesh/D010361",
        "https://schema.org/Patient"
      ],
      "editorialNote": "Patient is a schema.org type (Person + MedicalAudience), not a MedicalAudienceType value."
    },
    {
      "id": "https://health-culture.org/vocab/audiences/learners",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/audiences/",
      "prefLabel": "Learners and students",
      "definition": "Someone using a resource to learn, in or out of school. Use the population tags (teens, college students) to say who they are.",
      "related": [
        "https://health-culture.org/vocab/ecological-levels/intrapersonal"
      ],
      "hcf:facet": "role",
      "broader": "https://health-culture.org/vocab/audiences/the-person",
      "altLabel": [
        "students",
        "trainees"
      ],
      "example": "A high-school health class unit on sleep.",
      "closeMatch": [
        "http://id.nlm.nih.gov/mesh/D013334",
        "https://schema.org/EducationalAudience",
        "http://purl.org/dcx/lrmi-vocabs/educationalAudienceRole/student"
      ],
      "hcf:ericAudience": [
        "Students"
      ],
      "editorialNote": "Role (learner) vs population (college students) split: SleepLiteracy's Students and College are both mapped to population terms too."
    },
    {
      "id": "https://health-culture.org/vocab/audiences/populations",
      "type": "skos:Concept",
      "inScheme": "https://health-culture.org/vocab/audiences/",
      "prefLabel": "Who it is about",
      "definition": "Grouping concept for populations: the people whose health a resource is about. Combine with any role at any level (parents + teens; school leaders + teens).",
      "related": [
        "https://health-culture.org/vocab/ecological-levels/intrapersonal"
      ],
      "hcf:facet": "population",
      "topConceptOf": "https://health-culture.org/vocab/audiences/",
      "altLabel": [
        "population",
        "life stage",
        "people group"
      ],
      "closeMatch": [
        "http://id.nlm.nih.gov/mesh/D009272",
        "https://schema.org/PeopleAudience"
      ],
      "editorialNote": "Grouping node. Age ranges should also be stored as numbers (schema.org suggestedMinAge/suggestedMaxAge, LRMI typicalAgeRange), not only as concepts."
    },
    {
      "id": "https://health-culture.org/vocab/audiences/infants",
